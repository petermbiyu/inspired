<!doctype html>
<html lang="en">
  <!-- header  -->
  <%-include ("../../partials/header.ejs")%>
  <!-- end header -->
  <body
    class="bg-linear-to-r h-screen from-cyan-900 to-cyan-600 md:via-cyan-600 md:to-cyan-500"
  >
    <div>
      <!-- navbar -->
      <%-include ("../../partials/navbar.ejs")%>
      <!-- end navbar -->
      <div class="text-white py-3">
        <h2 class="text-2xl md:text-4xl lg:text-5xl font-bold text-center">
          Academic
        </h2>
      </div>
    </div>

    <section class="bg-blue-100 py-2">
      <div
        class="w-[90%] max-w-full mx-auto shadow-[0_15px_30px_10px_rgba(0,0,0,0.25)] bg-blue-50"
      >
        <div
          class="border-b-3 border-cyan-800 flex justify-between items-center"
        >
          <div class="w-[50%]">
            <button
              id="access-classes"
              class="my-2 ml-4 border-cyan-800 p-3 bg-cyan-800 text-white font-bold cursor-pointer"
            >
              My Classes
            </button>
          </div>
          <div class="w-[50%] flex justify-end px-8 text-xl font-semibold">
            <button class="cursor-pointer text-[1.3rem] text-cyan-800">
              <i class="fa-regular fa-envelope"></i>
            </button>
          </div>
        </div>
        <div
          class="flex min-h-[calc(100vh-270px)] flex-col justify-center items-center md:gap-6"
        >
          <div
            class="border-2 border-cyan-800 p-4 gap-2 grid grid-cols-2 w-200"
          >
            <div class="bg-cyan-800 text-white w-full flex flex-row p-3">
              <div class="w-[40%]">
                <div
                  class="max-w-max m-4 p-4 mx-auto border-4 border-transparent shadow-[0_3px_20px_5px_rgba(0,0,0,0.2)] rounded-full"
                >
                  <i class="fa-solid fa-user-graduate text-7xl"></i>
                </div>
              </div>
              <div class="w-[60%] pt-4">
                <h2 class="text-[1.2rem] mb-3 font-semibold">
                  Welcome back <span id="user-name">Tifanny</span>
                </h2>
                <p>Access your classes at your comfort anytime, anywhere.</p>
              </div>
            </div>
            <div class="bg-cyan-800 text-white w-full flex flex-row p-3">
              <div class="pt-4">
                <h2 class="text-[1.2rem] mb-3 font-semibold">
                  Uproaching Deadline
                </h2>
                <p>
                  You have 5 course with a deadline that will be expiring soon.
                </p>
              </div>
            </div>
          </div>
          <div
            class="grid grid-cols-2 gap-2 w-200 border-2 border-cyan-800 p-4"
          >
            <div
              class="w-full grid grid-cols-[2fr_6fr_1fr] py-2 px-4 bg-cyan-800 text-white"
            >
              <div class="text-5xl">
                <i class="fa-solid fa-chalkboard-user"></i>
              </div>
              <div class="font-semibold text-[1.1rem]">
                <p id="total-classes">10</p>
                <p>Classes</p>
              </div>
              <div class="text-right my-auto">
                <i class="fa-solid fa-angles-right"></i>
              </div>
            </div>
            <div
              class="w-full grid grid-cols-[2fr_6fr_1fr] py-2 px-4 bg-cyan-800 text-white"
            >
              <div class="text-5xl">
                <i class="fa-solid fa-book"></i>
              </div>
              <div class="font-semibold text-[1.1rem]">
                <p id="total-assessments">20</p>
                <p>Courses</p>
              </div>
              <div class="text-right my-auto">
                <i class="fa-solid fa-angles-right"></i>
              </div>
            </div>
            <div
              class="w-full grid grid-cols-[2fr_6fr_1fr] py-2 px-4 bg-cyan-800 text-white"
            >
              <div class="text-5xl">
                <i class="fa-solid fa-chart-area"></i>
              </div>
              <div class="font-semibold text-[1.1rem]">
                <p id="total-learners">200</p>
                <p>Learners</p>
              </div>
              <div class="text-right my-auto">
                <i class="fa-solid fa-angles-right"></i>
              </div>
            </div>
            <div>
              <div
                class="w-full grid grid-cols-[2fr_6fr_1fr] py-2 px-4 bg-cyan-800 text-white"
              >
                <div class="text-5xl">
                  <i class="fa-solid fa-chart-area"></i>
                </div>
                <div class="font-semibold text-[1.1rem]">
                  <p>80%</p>
                  <p>Score Rate</p>
                </div>
                <div class="text-right my-auto">
                  <i class="fa-solid fa-angles-right"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- footer -->
    <%- include ("../../partials/footer.ejs")%>
    <!-- end footer -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
    <script src="/js/script.js"></script>
    <script src="/js/academics/academic.js"></script>
    <script type="module" src="/js/dashboard.js"></script>
  </body>
</html>
