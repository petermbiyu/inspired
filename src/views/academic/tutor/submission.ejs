<!doctype html>
<html lang="en">
  <!-- header  -->
  <%-include ("../../partials/header.ejs")%>
  <!-- end header -->
  <body
    class="bg-linear-to-r h-screen from-cyan-900 to-cyan-600 md:via-cyan-600 md:to-cyan-500"
  >
    <!-- add class -->

    <div>
      <!-- navbar -->
      <%-include ("../../partials/navbar.ejs")%>
      <!-- end navbar -->
      <div class="text-white py-3">
        <h2 class="text-2xl md:text-4xl lg:text-5xl font-bold text-center">
          Submissions
        </h2>
      </div>
    </div>

    <section class="bg-blue-50">
      <div class="md:grid md:grid-cols-[20%_80%]">
        <!--md:grid md:grid-cols-[20%_80%]-->
        <!-- side nave -->
        <%- include("../../partials/tutorSideNav.ejs")%>
        <div class="relative w-full h-full">
          <!-- add btn -->
          <div>
            <div class="border-b-2 flex flex-row">
              <button
                id="submission-by-class"
                class="my-2 ml-4 border-cyan-800 p-3 bg-cyan-800 text-white font-bold cursor-pointer"
              >
                Assessments
              </button>
              <div>
                <select
                  name="assessment"
                  id="assessment"
                  class="my-2 ml-4 border-2 w-[250px] border-cyan-800 p-3 text-cyan-800 font-bold"
                >
                  <option selected disabled hidden>Select Assessment</option>
                  <option value="assessmentId">Intro to ICT</option>
                </select>
              </div>
            </div>
            <div>
              <div
                id="class-card"
                class="flex min-h-[calc(100vh-250px)] flex-wrap p-2 justify-center align-center gap-5"
              ></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- footer -->
    <%- include ("../../partials/footer.ejs")%>
    <!-- end footer -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
    <script src="/js/script.js"></script>
    <script src="/js/main.js"></script>
  </body>
</html>
