<!doctype html>
<html lang="en">
  <!-- header  -->
  <%-include ("../../partials/header.ejs")%>
  <!-- end header -->
  <body
    class="bg-linear-to-r h-screen from-cyan-900 to-cyan-600 md:via-cyan-600 md:to-cyan-500"
  >
    <!-- add class -->

    <div>
      <!-- navbar -->
      <%-include ("../../partials/navbar.ejs")%>
      <!-- end navbar -->
      <div class="text-white py-3">
        <h2 class="text-2xl md:text-4xl lg:text-5xl font-bold text-center">
          Assessment
        </h2>
      </div>
    </div>

    <section class="bg-blue-50">
      <div class="md:grid md:grid-cols-[20%_80%] min-h-135">
        <!--md:grid md:grid-cols-[20%_80%]-->
        <!-- side nave -->
        <%- include("../../partials/learnerSideNav.ejs")%>
        <div class="relative max-w-full h-full mx-4">
          <div
            class="border-b-4 p-4 flex justify-between justify-between items-center flex-row"
          >
            <div class="w-full flex justify-between items-center">
              <button
                id="start-assessment"
                class="bg-cyan-600 text-white text-[1.1rem] border-3 border-cyan-600 rounded-[3px] hover:text-cyan-600 hover:bg-white py-1 px-2 hover:text-shadow-sm transition-all duration-300 ease font-bold cursor-pointer"
              >
                Start <i class="fa-solid fa-angles-right"></i>
              </button>
              <button
                id="courses"
                class="bg-cyan-600 text-white text-[1.1rem] border-3 border-cyan-600 rounded-[3px] hover:text-cyan-600 hover:bg-white py-1 px-2 hover:text-shadow-sm transition-all duration-300 ease font-bold cursor-pointer"
              >
                <i class="fa-solid fa-angles-left"></i>Courses
              </button>
            </div>
          </div>

          <div
            class="bg-white w-full max-w-250 shadow-[0px_3px_10px_rgba(0,0,0,0.3)] py-2 mx-auto my-10"
          >
            <h2
              id="assessment-title"
              class="text-2xl text-center font-bold mt-2"
            >
              <!-- Assessment title -->
            </h2>
            <div class="px-4 py-2">
              <div
                id="assessment-questions"
                class="pb-1 text-[1.2rem] border-b-2 border-cyan-300"
              >
                <!-- Add assessment questions here -->
              </div>
            </div>
          </div>
        </div>
      </div>
      <div>
        <p
          id="message"
          class="px-2 py-3 absolute w-70 top-2 right-2 hidden font-semibold border-b-2 border-cyan-100 text-cyan-700 bg-cyan-50 text-center"
        ></p>
      </div>
    </section>

    <!-- footer -->
    <%- include ("../../partials/footer.ejs")%>
    <!-- end footer -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
    <script src="/js/script.js"></script>
    <script src="/js/main.js"></script>
    <script
      type="module"
      src="/js/academics/learner/viewAssessQuestions.js"
    ></script>
    <script src="/js/academics/learner/assessSubmission.js"></script>
  </body>
</html>
