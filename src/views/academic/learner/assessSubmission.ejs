<!doctype html>
<html lang="en">
  <!-- header  -->
  <%-include ("../../partials/header.ejs")%>
  <!-- end header -->
  <body
    class="bg-linear-to-r h-screen from-cyan-900 to-cyan-600 md:via-cyan-600 md:to-cyan-500"
  >
    <div>
      <!-- navbar -->
      <%-include ("../../partials/navbar.ejs")%>
      <!-- end navbar -->
      <div class="text-white py-3">
        <h2 class="text-2xl md:text-4xl lg:text-5xl font-bold text-center">
          My Submission
        </h2>
      </div>
    </div>

    <section class="bg-blue-50">
      <div class="md:grid md:grid-cols-[20%_80%]">
        <!-- side nave -->
        <%- include("../../partials/learnerSideNav.ejs")%>
        <div class="relative">
          <div
            class="flex min-h-[calc(100vh-390px)] flex-wrap md:flex-row justify-center items-center gap-5"
          >
            <div
              class="w-full max-w-[1024px] p-1 md:p-4 bg-white shadow-[0_10px_30px_5px_rgba(0,0,0,0.25)]"
            >
              <h2
                class="text-center text-2xl md:text-3xl py-2 md:py-4 font-semibold border-b-3"
                id="assess-title"
              >
                assessment-title
              </h2>
              <div class="text-[1.1rem] mt-4" id="assessmentQuestion">
                <h3 class="font-semibold text-[1.3rem]">Please note:</h3>
                <ol class="list-decimal ml-8">
                  <li>
                    The questions will appear one by one and based on the
                    question type you are expected to select or write the answer
                    and submit it before proceeding to the next question.
                  </li>
                  <li>
                    Please do not reload the page once the assessment has began
                    (you have clicked the start button)
                  </li>
                  <li>
                    You can click on the restart button if you want to start
                    again the assessment
                  </li>
                  <li>
                    Once you reach the final question and submit for analysis
                    you wont be able to restart or redo the assessment unless
                    the tutor grants the permission.
                  </li>
                </ol>
              </div>

              <div>
                <div class="mt-4">
                  <button
                    id="save-btn"
                    class="hidden py-2 bg-cyan-600 mx-1 md:mx-2 cursor-pointer hover:bg-cyan-700 text-white animation duration-300 ease rounded-[5px] w-[80px] font-semibold"
                  >
                    Save
                  </button>
                </div>
                <div class="mt-4 flex justify-center">
                  <button
                    id="start-btn"
                    class="py-2 bg-cyan-600 mx-1 md:mx-2 cursor-pointer hover:bg-cyan-700 text-white animation duration-300 ease rounded-[5px] w-[80px] font-semibold"
                  >
                    Start
                  </button>
                  <button
                    id="restart-btn"
                    class="hidden py-2 bg-cyan-600 mx-1 md:mx-2 cursor-pointer hover:bg-cyan-700 text-white animation duration-300 ease rounded-[5px] w-[80px] font-semibold"
                  >
                    Restart
                  </button>
                  <button
                    id="next-btn"
                    class="hidden py-2 bg-cyan-600 mx-1 md:mx-2 cursor-pointer hover:bg-cyan-700 text-white animation duration-300 ease rounded-[5px] w-[80px] font-semibold"
                  >
                    Next
                  </button>
                  <button
                    id="submit-btn"
                    class="hidden py-2 bg-cyan-600 mx-1 md:mx-2 cursor-pointer hover:bg-cyan-700 text-white animation duration-300 ease rounded-[5px] w-[80px] font-semibold"
                  >
                    Submit
                  </button>
                  <button
                    id="skip-btn"
                    class="hidden py-2 bg-cyan-600 mx-1 md:mx-2 cursor-pointer hover:bg-cyan-700 text-white animation duration-300 ease rounded-[5px] w-[80px] font-semibold"
                  >
                    Skip
                  </button>
                  <button
                    id="send-btn"
                    class="hidden py-2 bg-cyan-600 mx-1 md:mx-2 cursor-pointer hover:bg-cyan-700 text-white animation duration-300 ease rounded-[5px] w-[80px] font-semibold"
                  >
                    Send
                  </button>
                  <button
                    id="cancel-btn"
                    class="py-2 bg-cyan-600 mx-1 md:mx-2 cursor-pointer hover:bg-cyan-700 text-white animation duration-300 ease rounded-[5px] w-[80px] font-semibold"
                  >
                    Cancel
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div>
        <p
          id="message"
          class="px-2 py-3 absolute w-70 top-2 right-2 hidden font-semibold border-b-2 border-cyan-100 text-cyan-700 bg-cyan-50 text-center"
        ></p>
      </div>
    </section>

    <!-- footer -->
    <%- include ("../../partials/footer.ejs")%>
    <!-- end footer -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
    <script
      type="module"
      src="/js/academics/learner/assessQuestions.js"
    ></script>
    <script src="/js/script.js"></script>
  </body>
</html>
